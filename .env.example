# Discord Bot Token (필수)
DISCORD_TOKEN=your_discord_bot_token_here

# data.go.kr API Key (필수) - https://www.data.go.kr 에서 발급
DATA_GO_KR_API_KEY=your_api_key_here

# 알림을 보낼 디스코드 채널 ID (필수)
NOTIFICATION_CHANNEL_ID=123456789

# 데이터베이스 경로 (선택, 기본값: data/notifications.db)
DATABASE_PATH=data/notifications.db

# API Base URL (선택, 기본값: https://api.odcloud.kr/api)
API_BASE_URL=https://api.odcloud.kr/api

# 폴링 주기 (분, 선택, 기본값: 30)
POLLING_INTERVAL_MINUTES=30

# 개발용 Guild ID (선택, 설정시 해당 서버에만 슬래시 명령어 동기화)
DEV_GUILD_ID=
